{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "node scripts/dev-orchestrator.mjs",
    "dev:app": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "dev:mcp": "node scripts/run-mlb-mcp.mjs",
    "worktree:new": "node scripts/worktree-bootstrap.mjs",
    "worktree:list": "git worktree list",
    "worktree:close": "node scripts/worktree-close.mjs",
    "worktree:prune": "git worktree prune",
    "gh:pr:status": "node scripts/gh-pr-status.mjs",
    "gh:pr:create": "gh pr create --fill",
    "gh:pr:checks": "gh pr checks",
    "build": "npm run plugin:ui:build && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "npm run plugin:ui:build && tsc",
    "lint": "eslint client/src server shared",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:push": "drizzle-kit push",
    "db:migration:dump": "node scripts/postgres-migration.mjs dump",
    "db:migration:restore": "node scripts/postgres-migration.mjs restore",
    "db:migration:verify": "node scripts/postgres-migration.mjs verify",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "code:dead": "knip --include dependencies,devDependencies,unlisted,binaries,unresolved",
    "code:dup": "jscpd",
    "seo:check": "node scripts/seo-check.mjs",
    "docs:build": "node scripts/docs-build.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:governance": "node scripts/docs-governance.mjs",
    "context:audit": "node scripts/context-audit.mjs",
    "cli": "node packages/sportfolio-cli/bin/sportfolio.mjs",
    "cli:smoke": "node scripts/cli-smoke.mjs",
    "e2e": "playwright test",
    "e2e:server": "node scripts/playwright-web-server.mjs",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps",
    "visual:test": "playwright test --config=playwright.visual.config.ts",
    "visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "mobile:sync": "npm run build:client && npx cap sync && node scripts/fix-ios-spm-paths.mjs",
    "mobile:sync:ios": "npm run build:client && npx cap sync ios && node scripts/fix-ios-spm-paths.mjs",
    "mobile:sync:android": "npm run build:client && npx cap sync android && node scripts/fix-ios-spm-paths.mjs",
    "mobile:sync:ios:dev": "cross-env CAP_SERVER_URL=http://localhost:5000 npm run mobile:sync:ios",
    "mobile:sync:android:dev": "cross-env CAP_SERVER_URL=http://10.0.2.2:5000 npm run mobile:sync:android",
    "mobile:sync:prod": "cross-env CAP_SERVER_URL=https://www.sportfolio.market npm run mobile:sync",
    "mobile:ios": "npx cap open ios",
    "mobile:ios:doctor": "node scripts/mobile-ios-doctor.mjs",
    "mobile:ios:app-store-prep": "node scripts/app-store-connect-submission-prep.mjs",
    "mobile:android": "npx cap open android",
    "mobile:build:ios": "cd mobile/ios/App && xcodebuild -project App.xcodeproj -scheme App -configuration Release -destination generic/platform=iOS",
    "mobile:build:ios:ci": "cd mobile/ios/App && xcodebuild -project App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS Simulator' -derivedDataPath ../../../tmp/ios-derived-data CODE_SIGNING_ALLOWED=NO",
    "mobile:build:android": "npm run mobile:sync && node scripts/run-gradle-wrapper.mjs assembleRelease",
    "mobile:install:android": "npm run mobile:sync && node scripts/run-gradle-wrapper.mjs installDebug",
    "android:sdk:check": "node scripts/android-sdk-check.mjs",
    "android:emulator:setup": "node scripts/android-emulator-setup.mjs",
    "audit:android-push": "node scripts/android-push-audit-report.mjs",
    "play:billing:doctor": "node scripts/play-billing-doctor.mjs",
    "play:billing:ensure-product": "node scripts/play-billing-doctor.mjs --ensure",
    "play:release:preflight": "node scripts/play-release-preflight.mjs",
    "build:client": "npm run plugin:ui:build && vite build",
    "prepare": "husky",
    "openapi:check": "node scripts/openapi-check.mjs",
    "invariants:check": "node scripts/check-agent-invariants.mjs",
    "qa:smoke": "node scripts/agent-readiness-smoke.mjs",
    "agent:debug": "node scripts/agent-debug-loop.mjs",
    "agent:improve": "node scripts/agent-self-improve.mjs",
    "cli:audit": "tsx scripts/cli-audit.ts",
    "mcp:audit": "tsx scripts/mcp-audit.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "plugin:ui:build": "node scripts/build-plugin-ui.mjs",
    "plugin:ui:audit": "tsx scripts/plugin-ui-audit.ts",
    "bot:liquidity:report": "tsx scripts/bot-liquidity-spread-report.ts",
    "mlb-mcp:start": "node scripts/mlb-mcp-local.mjs start",
    "mlb-mcp:start:detached": "node scripts/mlb-mcp-local.mjs start-detached",
    "mlb-mcp:status": "node scripts/mlb-mcp-local.mjs status",
    "mlb-mcp:stop": "node scripts/mlb-mcp-local.mjs stop",
    "mlb-mcp:probe": "node scripts/mlb-mcp-probe.mjs",
    "mlb-mcp:full-validate": "tsx scripts/mlb-mcp-full-validate.ts",
    "mlb-mcp:probe:railway": "node scripts/mlb-mcp-railway-smoke.mjs",
    "public-surface:dev": "tsx scripts/public-surface-dev-validate.ts",
    "text:check": "node scripts/check-text-encoding.mjs",
    "redditbot:typecheck": "npm --prefix packages/sportfoliobot run typecheck",
    "redditbot:playtest": "npm --prefix packages/sportfoliobot run playtest",
    "redditbot:upload": "npm --prefix packages/sportfoliobot run upload",
    "redditbot:settings:list": "npm --prefix packages/sportfoliobot run settings:list",
    "public-tools:audit": "tsx scripts/audit-public-tool-policy.ts",
    "db:migrate:scout-claims": "node scripts/apply-scout-claims-migration.mjs",
    "audit:sports-semantics": "tsx scripts/audit-unified-sports-semantics.ts",
    "governance:capabilities": "tsx scripts/public-capability-governance.ts check",
    "governance:capabilities:snapshot": "tsx scripts/public-capability-governance.ts snapshot",
    "governance:capabilities:update": "tsx scripts/public-capability-governance.ts update",
    "auth:config:test": "vitest run server/auth/config.test.ts",
    "auth:supabase-inventory": "tsx scripts/auth-supabase-inventory.ts",
    "auth:compatibility:test": "vitest run scripts/auth-supabase-inventory.test.ts scripts/better-auth-compatibility.test.ts server/auth/architecture-contract.test.ts",
    "auth:foundation:test": "vitest run server/auth/principal.test.ts server/auth/better-auth.test.ts server/supabaseAuth.test.ts",
    "auth:email:test": "vitest run server/auth/magic-link-delivery.test.ts server/auth/resend-webhook.test.ts"
  },
