# Supabase Database Connection (PRODUCTION)
# Get this from Supabase Dashboard > Project Settings > Database > Connection string
# Use the "Session mode" pooler connection for Railway (persistent server)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres

# Local Development Database (Docker)
# Start with: docker-compose -f docker-compose.dev.yml up -d
DEV_DATABASE_URL=postgresql://postgres:devpassword@localhost:5433/sportfolio_dev

# Supabase Auth (from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Supabase Anon Key (for client-side auth)
SUPABASE_ANON_KEY=your-anon-key-here

# Sports Data APIs
# MLB StatsAPI - PUBLIC, NO AUTH REQUIRED
# The official MLB StatsAPI (https://statsapi.mlb.com) is a public API.
# No environment variable is needed. MLB roster/schedule/stats data
# is fetched directly from statsapi.mlb.com/api/v1/...
#
# MySportsFeeds - NBA data (https://www.mysportsfeeds.com/)
# Currently disabled during the MLB/NASCAR-only migration.
MYSPORTSFEEDS_API_KEY=your-mysportsfeeds-api-key-here

# Ball Don't Lie and other paid API keys have been removed.
# The codebase no longer depends on Ball Don't Lie for any sport data.

# Perplexity API - AI news generation (https://www.perplexity.ai/)
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Optional dedicated secret for HMAC-hashing user CLI API tokens.
USER_API_TOKEN_SECRET=

# Internal MLB MCP provider
MLB_MCP_ENABLED=true
# Railway private-network example: http://mlb-mcp.railway.internal:8080/mcp
MLB_MCP_URL=http://127.0.0.1:8081/mcp
MLB_MCP_TIMEOUT_MS=12000
MLB_MCP_HEALTH_CACHE_MS=60000
# Optional bearer token when the provider requires application-layer authorization.
MLB_MCP_AUTH_BEARER=

# Observability (optional)
# Sentry (server + client)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=

# Client-side Sentry (Vite)
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=

# Prometheus metrics endpoint. METRICS_TOKEN is mandatory when enabled in production.
METRICS_ENABLED=false
METRICS_TOKEN=

# OpenTelemetry tracing
OTEL_ENABLED=false
# Example: http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=

# Environment (set to 'production' on Railway)
NODE_ENV=development
# Explicit local-only opt-in. Never enable on shared or deployed environments.
DEV_BYPASS_AUTH=false

# Canonical public site URL (used by sitemap and SEO metadata)
PUBLIC_SITE_URL=https://www.sportfolio.market
VITE_PUBLIC_SITE_URL=https://www.sportfolio.market

# Discord integration (slash commands + posting + report sync)
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_LINK_STATE_SECRET=
DISCORD_NEWS_CHANNEL_ID=
DISCORD_HOURLY_CHANNEL_ID=
DISCORD_MUTATION_ROLE_ID=
DISCORD_REPORT_MOD_ROLE_ID=
DISCORD_BUG_FORUM_CHANNEL_ID=
DISCORD_FEATURE_FORUM_CHANNEL_ID=

# GitHub issue sync target for /report submit
GITHUB_ISSUE_SYNC_TOKEN=
GITHUB_ISSUE_OWNER=michaelhmiv
GITHUB_ISSUE_REPO=Sportfolio

# Optional SEO/indexing controls
ENFORCE_CANONICAL_HOST_REDIRECT=true
PUBLIC_API_VERSION=2026-02-25

# Capacitor native runtime URL override (optional)
CAP_SERVER_URL=https://www.sportfolio.market

# Android release versioning (optional)
MOBILE_VERSION_CODE=10001
MOBILE_VERSION_NAME=1.0.0

# Google Play Billing (Android premium purchases)
# Provide one of:
# - PLAY_SERVICE_ACCOUNT_JSON (raw JSON or base64 JSON)
# - PLAY_SERVICE_ACCOUNT_FILE (absolute path on disk)
PLAY_SERVICE_ACCOUNT_JSON=
PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_PACKAGE_NAME=sportfolio.market
GOOGLE_PLAY_PREMIUM_PRODUCT_ID=premium_share_1
GOOGLE_PLAY_PREMIUM_PRODUCT_IDS=premium_share_1
GOOGLE_PLAY_PREMIUM_PRICE_USD=5
# Frontend Android product ID override
VITE_ANDROID_PREMIUM_PRODUCT_ID=premium_share_1

# App version injected at build time for push token registration
# Automatically read from package.json via npm_package_version — no need to set manually.
# Override here only if you need to force a specific version string in dev.
VITE_APP_VERSION=

# Firebase Admin SDK (Android push notifications via FCM)
# Provide one of:
# - FIREBASE_ADMIN_SDK_JSON (raw JSON or base64 JSON)
# - FIREBASE_ADMIN_SDK_FILE (absolute path on disk)
FIREBASE_ADMIN_SDK_JSON=
FIREBASE_ADMIN_SDK_FILE=

# Optional push reminder tuning
BOOST_LOCKING_SOON_WINDOW_MINUTES=25

# App Store Connect (iOS App Store metadata and review automation)
# Use either APP_STORE_CONNECT_API_KEY_BASE64 or APP_STORE_CONNECT_P8_PATH.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_BASE64=
APP_STORE_CONNECT_P8_PATH=

# Android rewarded scout boost / AdMob
# Publisher ID served from /ads.txt for AdSense / Ad Manager site verification
ADSENSE_PUBLISHER_ID=pub-2708638041809482
# Production Android manifest app ID for the Google Mobile Ads SDK quick-start flow
ADMOB_APP_ID_ANDROID=ca-app-pub-2708638041809482~8217225961
# Production iOS Info.plist app ID for the Google Mobile Ads SDK
ADMOB_APP_ID_IOS=ca-app-pub-2708638041809482~5136903497
# Default rewarded ad unit used by /api/mobile/rewarded-scout-boost/session when platform-specific values are absent
ADMOB_REWARDED_SCOUT_AD_UNIT_ID=ca-app-pub-2708638041809482/7806162422
# Optional platform-specific rewarded ad units (recommended)
ADMOB_REWARDED_SCOUT_AD_UNIT_ID_ANDROID=ca-app-pub-2708638041809482/7806162422
ADMOB_REWARDED_SCOUT_AD_UNIT_ID_IOS=ca-app-pub-2708638041809482/5575887198
# HMAC secret for signing rewarded scout boost session custom_data payloads
REWARDED_SCOUT_BOOST_SECRET=
