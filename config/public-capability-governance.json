{
  "schemaVersion": 1,
  "owner": "michaelhmiv",
  "scanPaths": [
    "server/mcp/public-tool-registry.ts",
    "server/mcp/plugin/registry.ts",
    "server/mcp/plugin/ui",
    "server/routes/mcp.ts",
    "server/routes/plugin-mcp.ts",
    "server/scheduler.ts",
    "server/jobs/job-registry.ts",
