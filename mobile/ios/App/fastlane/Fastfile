default_platform(:ios)

platform :ios do
  private_lane :app_store_connect_api_key_from_env do
    required_upload_env = %w[
      APP_STORE_CONNECT_KEY_ID
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_API_KEY_BASE64
    ]
    required_upload_env.each do |name|
      UI.user_error!("Missing required App Store Connect environment variable: #{name}") if ENV[name].to_s.strip.empty?
    end

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64"),
      is_key_content_base64: true
    )
  end

  private_lane :app_review_information_from_env do |options|
    metadata_path = options[:metadata_path].to_s.strip
    metadata_path = "fastlane/metadata" if metadata_path.empty?

    required_review_env = %w[
      APP_STORE_REVIEW_CONTACT_FIRST_NAME
      APP_STORE_REVIEW_CONTACT_LAST_NAME
      APP_STORE_REVIEW_CONTACT_EMAIL
      APP_STORE_REVIEW_CONTACT_PHONE
    ]
    required_review_env.each do |name|
      UI.user_error!("Missing required App Review contact environment variable: #{name}") if ENV[name].to_s.strip.empty?
    end

    notes_path = File.join(metadata_path, "review_information", "notes.txt")
    UI.user_error!("Missing App Review notes file: #{notes_path}") unless File.file?(notes_path)

    {
      first_name: ENV.fetch("APP_STORE_REVIEW_CONTACT_FIRST_NAME"),
      last_name: ENV.fetch("APP_STORE_REVIEW_CONTACT_LAST_NAME"),
      email_address: ENV.fetch("APP_STORE_REVIEW_CONTACT_EMAIL"),
      phone_number: ENV.fetch("APP_STORE_REVIEW_CONTACT_PHONE"),
      notes: File.read(notes_path, encoding: "UTF-8")
    }
  end

  desc "Build signed iOS IPA and optionally upload to TestFlight"
  lane :testflight_ci do |options|
    required_env = %w[
      IOS_APP_IDENTIFIER
      IOS_PROJECT_PATH
      IOS_SCHEME
      IOS_BUILD_NUMBER
      IOS_PROFILE_NAME
      IOS_TEAM_ID
    ]

    required_env.each do |name|
      UI.user_error!("Missing required environment variable: #{name}") if ENV[name].to_s.strip.empty?
    end

    skip_upload = options[:skip_upload].to_s == "true"
    release_name = options[:release_name].to_s.strip
    output_directory = ENV["IOS_OUTPUT_DIR"].to_s.strip
    output_directory = "tmp/ios-testflight" if output_directory.empty?

    increment_build_number(
      xcodeproj: ENV.fetch("IOS_PROJECT_PATH"),
      build_number: ENV.fetch("IOS_BUILD_NUMBER")
    )

    marketing_version = ENV["IOS_MARKETING_VERSION"].to_s.strip
    unless marketing_version.empty?
      increment_version_number(
        xcodeproj: ENV.fetch("IOS_PROJECT_PATH"),
        version_number: marketing_version
      )
    end

    update_code_signing_settings(
      use_automatic_signing: false,
      path: ENV.fetch("IOS_PROJECT_PATH"),
      team_id: ENV.fetch("IOS_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: ENV.fetch("IOS_PROFILE_NAME"),
      bundle_identifier: ENV.fetch("IOS_APP_IDENTIFIER")
    )

    build_app(
      project: ENV.fetch("IOS_PROJECT_PATH"),
      scheme: ENV.fetch("IOS_SCHEME"),
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      include_symbols: true,
      include_bitcode: false,
      output_directory: output_directory,
      output_name: "Sportfolio.ipa",
      export_options: {
        provisioningProfiles: {
          ENV.fetch("IOS_APP_IDENTIFIER") => ENV.fetch("IOS_PROFILE_NAME")
        }
      }
    )

    privacy_audit_script = File.expand_path("../../../scripts/mobile-ios-privacy-manifest-audit.sh", Dir.pwd)
    UI.user_error!("Missing iOS privacy-manifest audit script: #{privacy_audit_script}") unless File.file?(privacy_audit_script)
    sh("bash", privacy_audit_script)

    if skip_upload
      UI.important("skip_upload=true, signed IPA built and privacy-audited without TestFlight upload.")
      next
    end

    api_key = app_store_connect_api_key_from_env

    changelog = release_name.empty? ? nil : "Release #{release_name}"
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: changelog
    )
  end

  desc "Upload App Store listing metadata and screenshots without submitting for review"
  lane :app_store_listing_ci do |options|
    app_identifier = ENV["IOS_APP_IDENTIFIER"].to_s.strip
    app_identifier = "com.sportfoliomarket.app" if app_identifier.empty?

    metadata_path = options[:metadata_path].to_s.strip
    metadata_path = "fastlane/metadata" if metadata_path.empty?

    screenshots_path = options[:screenshots_path].to_s.strip
    screenshots_path = "fastlane/screenshots" if screenshots_path.empty?

    skip_screenshots = options[:skip_screenshots].to_s == "true"

    api_key = app_store_connect_api_key_from_env
    review_information = app_review_information_from_env(metadata_path: metadata_path)

    deliver(
      api_key: api_key,
      app_identifier: app_identifier,
      metadata_path: metadata_path,
      screenshots_path: screenshots_path,
      app_review_information: review_information,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: skip_screenshots,
      submit_for_review: false,
      force: true,
      overwrite_screenshots: !skip_screenshots,
      precheck_include_in_app_purchases: false,
      precheck_default_rule_level: :error
    )

    UI.success("App Store listing metadata, App Review information#{skip_screenshots ? "" : ", and screenshots"} uploaded without review submission.")
  end
end
