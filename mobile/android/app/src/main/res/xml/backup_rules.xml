<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below full-backup-content rules.
    Excludes all application data from Auto Backup to prevent auth token leakage
    via cloud backup or device-to-device transfer (see data_extraction_rules.xml
    for the Android 12+ equivalent).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
