{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "client/src/main.tsx",
    "client/src/plugin-ui/sportfolio-widget-entry.ts",
    "client/src/connected-apps-entry.tsx",
    "client/src/oauth-consent-entry.tsx",
    "client/src/plugin-docs-entry.tsx",
    "client/src/plugin-support-entry.tsx",
    "server/index.ts",
    "server/worker.ts",
    "*.config.{js,ts}",
    "execute-sql.ts"
  ],
  "project": [
    "client/src/**/*.{ts,tsx}",
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.{js,cjs,mjs,ts}",
    "tests/**/*.ts",
    "*.config.{js,ts}",
    "execute-sql.ts"
  ],
  "includeEntryExports": true,
  "ignore": [
    "dist/**",
    "node_modules/**",
    "mobile/**",
    "package/**",
    "packages/**",
    "tmp/**",
    "attached_assets/**",
    "migrations/**",
    "vendor/**"
  ],
  "ignoreDependencies": ["@capacitor/android", "@capacitor/clipboard", "@capacitor/ios"],
  "ignoreBinaries": ["gh"],
  "ignoreUnresolved": ["./jobs/sync-player-game-logs"],
  "drizzle": false
}
